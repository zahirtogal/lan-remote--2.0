{
  "name": "lan-remote",
  "productName": "LAN Remote",
  "description": "Professional LAN Remote Desktop Application",
  "author": "LAN Remote Team",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "start:electron": "electron .",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pack": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@nut-tree/nut-js": "^3.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.lanremote.app",
    "productName": "LAN Remote",
    "directories": {
      "buildResources": "build",
      "output": "C:/tmp_lan_remote_build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}